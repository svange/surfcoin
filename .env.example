# =============================================================================
# surfcoin — deployment environment configuration (committed template)
# =============================================================================
#
# This is the SINGLE committed source of truth for the STATIC environment
# configuration the CI/CD pipeline (.github/workflows/deploy.yaml) reads from
# GitHub. It enumerates, by name, every operator-managed GitHub Actions
# *variable* and *secret* the pipeline consumes. Config becomes reviewable and
# reproducible instead of drifting by hand in the GitHub UI.
#
# Workflow for the operator:
#
#     cp .env.example .env        # then fill in the values for your AWS account
#     npm run sync:env            # DRY RUN — prints what would change, no writes
#     npm run sync:env -- --apply # writes the values to GitHub (needs `gh` auth)
#
# `.env` is gitignored and must never be committed — a pre-commit hook and
# gitleaks both block it. Only THIS `.env.example` (names + placeholders, never
# real values) is committed. See docs/environment-config.md for the full model.
#
# Classification rule (parsed by scripts/sync-env.sh):
#   * a line ending in the `# @secret` marker is pushed as a GitHub Actions
#     *secret*   (`gh secret set`)
#   * every other assignment is pushed as a GitHub Actions *variable*
#     (`gh variable set`)
#
# NOT listed here, by design:
#   * DYNAMIC values — CloudFront distribution id, the site S3 bucket, the
#     Cognito user-pool / client / domain ids, the API endpoint, the SiteUrl —
#     are RETRIEVED from CloudFormation stack outputs inside the pipeline
#     (scripts/publish-frontend.sh, scripts/sync-playground-config.sh). Never
#     hand-store them; they change on every stack update.
#   * GITHUB_TOKEN — GitHub injects an ephemeral token into every workflow run
#     automatically; it is not operator-managed.
# -----------------------------------------------------------------------------

# --- AWS deploy identity (account-specific ARNs — no long-lived keys) ---------
# OIDC role the pipeline assumes to deploy (repo-scoped: `surfcoin-deploy`).
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::000000000000:role/surfcoin-deploy
# CloudFormation execution role SAM passes to CloudFormation (`sam deploy --role-arn`).
CFN_EXEC_ROLE_ARN=arn:aws:iam::000000000000:role/surfcoin-cfn-exec
# Org-provisioned S3 bucket SAM uploads packaged artifacts to (`sam deploy --s3-bucket`).
ARTIFACTS_BUCKET=surfcoin-sam-artifacts

# --- Stack identity (mirrors samconfig.toml — keep the two in sync) ----------
# CloudFormation stack name. Matches `stack_name` in samconfig.toml.
STACK_NAME=surfcoin
# Deploy region. Matches `region` in samconfig.toml.
AWS_REGION=us-east-1

# --- Site / DNS parameters (passed to the template as --parameter-overrides) --
# Apex domain for the site + ACM certificate.
DOMAIN_NAME=surfcoin.fail
# Route53 hosted-zone id that hosts DOMAIN_NAME.
FAIL_HOSTED_ZONE_ID=Z00000000000000000000
# Cognito Hosted-UI domain prefix (must be globally unique in the region).
COGNITO_DOMAIN_PREFIX=surfcoin-auth

# --- Secrets ------------------------------------------------------------------
# Optional. Fine-grained PAT used by the `release` job so semantic-release can
# push tags / releases / the changelog to `main` (needs `contents: write`). The
# job falls back to the ephemeral GITHUB_TOKEN when this is unset, so leave it
# blank unless you want releases attributed to a dedicated token. Create one at
# https://github.com/settings/tokens?type=beta (scoped to this repo).
GH_TOKEN=                       # @secret
