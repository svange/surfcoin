{
  // Enforcing dependency vulnerability gate for CI (replaces `npm audit ... || true`).
  // Fails the build on any high or critical advisory in *production* dependencies.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  // Empty by design. GHSA-qwww-vcr4-c8h2 (react-router RSC-mode CSRF) was
  // allowlisted on 2026-07-29 while no non-major fix existed; react-router-dom
  // 7.18.2 patches it, so the bump replaced the exception on 2026-08-13.
  // Anything added back here needs the advisory id, why it does not apply to
  // this app, and the date it was reviewed.
  //
  // Known residual below this gate's threshold (no allowlist needed, no fix
  // published upstream): GHSA-w5hq-g745-h8pq, uuid <11.1.1, reached only as
  // @solana/web3.js 1.98.4 -> jayson 4.3.0 -> uuid 8.3.2. Moderate, and the
  // only "fix" npm offers is a bogus downgrade to @solana/web3.js 0.0.3.
  // Renovate picks it up automatically once jayson or web3.js ships one.
  "allowlist": []
}
