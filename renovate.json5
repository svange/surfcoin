// Renovate config — service repo (single `main` branch, deploys infra via gitops).
// Adapted from the org's canonical service template (ai-cc-tools) for a Node repo:
// npm manager instead of pep621, same commit-prefix -> release conventions.
//
// This file only describes WHAT Renovate should do. Whether it runs at all, and
// whether its PRs can merge themselves, depends on three repository settings an
// operator owns (issue #25, and CLAUDE.md > "Dependency updates"):
//   1. the hosted Renovate GitHub App installed with access to this repo,
//   2. "Allow auto-merge" enabled in repo settings (platformAutomerge below),
//   3. the `main` ruleset not demanding a code-owner review a bot cannot give.
// `.github/workflows/maintenance.yaml` alarms if Renovate goes silent anyway.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],

  "schedule": ["before 11:59pm on Sunday"],
  "timezone": "America/Los_Angeles",
  "platformAutomerge": true,
  // Squash, not merge-commit: `main` history is squash-only and semantic-release
  // reads the squashed subject. A merge commit lands as "Merge pull request #N
  // from renovate/...", which parses as no release type -- every `fix(deps):`
  // security bump would silently stop cutting a release.
  "automergeStrategy": "squash",
  "rangeStrategy": "auto",
  "rebaseWhen": "behind-base-branch",

  // The Dependency Dashboard issue is this repo's liveness beacon for Renovate:
  // if that issue does not exist, Renovate is not reaching the repo at all
  // (a config error is reported there and nowhere else). The freshness probe in
  // .github/workflows/maintenance.yaml checks for exactly this.
  "dependencyDashboard": true,

  // Source vulnerability alerts from OSV as well as GitHub's, so security PRs
  // still flow if Dependabot alerts are ever off in repo settings.
  "osvVulnerabilityAlerts": true,

  "enabledManagers": [
    "npm",
    "pre-commit",
    "github-actions"
  ],

  "labels": ["dependencies", "renovate"],

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 11:59pm on the first day of the month"],
    "commitMessageAction": "refresh",
    "automerge": true
  },

  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["dependencies", "security"],
    "commitMessagePrefix": "fix(deps):",
    "automerge": true
  },

  "packageRules": [
    // --- Runtime dependencies: fix(deps): — triggers a patch release ---
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "commitMessagePrefix": "fix(deps):",
      "automerge": true
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor"],
      "commitMessagePrefix": "fix(deps):",
      "automerge": false
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "fix(deps):",
      "automerge": false,
      "dependencyDashboardApproval": true
    },

    // --- Dev dependencies: chore(deps-dev): — grouped, no release ---
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "commitMessagePrefix": "chore(deps-dev):",
      "automerge": true,
      "groupName": "dev dependency updates",
      "groupSlug": "dev-deps"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "chore(deps-dev):",
      "automerge": false
    },

    // --- GitHub Actions ---
    {
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "ci(deps):",
      "automerge": true,
      "groupName": "GitHub Actions",
      "groupSlug": "gh-actions"
    },

    // --- Pre-commit hooks ---
    {
      "matchManagers": ["pre-commit"],
      "commitMessagePrefix": "ci(deps):",
      "automerge": true
    }
  ]
}
